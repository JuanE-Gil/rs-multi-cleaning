---
import { navLinks } from '../../data/nav';
import type { NavKey } from '../../data/nav';
import { empresa } from '../../data/empresa';
import Button from '../ui/Button.astro';

interface Props {
  currentPage: NavKey;
}

const { currentPage } = Astro.props;
---

<details class="relative md:hidden">
  <summary
    class="flex h-11 w-11 cursor-pointer list-none items-center justify-center rounded-md text-white [&::-webkit-details-marker]:hidden"
    aria-label="Abrir menú"
  >
    <svg aria-hidden="true" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
      <path d="M4 6h16M4 12h16M4 18h16" />
    </svg>
  </summary>

  <nav
    aria-label="Menú móvil"
    class="absolute right-0 top-[calc(100%+8px)] w-64 rounded-lg border border-hairline bg-white p-4 shadow-md"
  >
    <ul class="flex flex-col gap-1">
      {navLinks.map((link) => (
        <li>
          <a
            href={link.href}
            aria-current={link.key === currentPage ? 'page' : undefined}
            class:list={[
              'flex min-h-11 items-center rounded-md px-3 py-2.5 font-body text-sm font-semibold',
              link.key === currentPage ? 'bg-mist text-teal-ink' : 'text-navy hover:bg-navy-50',
            ]}
          >
            {link.label}
          </a>
        </li>))}
    </ul>

    <div class="mt-3 border-t border-hairline pt-3">
      <Button href="/contacto" variant="primary" class="w-full justify-center">
        Cotizar
      </Button>
      <a
        href={`tel:${empresa.telefonoFijo.replace(/[^\d+]/g, '')}`}
        class="mt-2 flex min-h-11 items-center justify-center text-sm font-semibold text-teal-ink"
      >
        ☎ {empresa.telefonoFijo}
      </a>
    </div>
  </nav>
</details>