---
import Container from '../ui/Container.astro';
import Button from '../ui/Button.astro';
import SectionHeading from '../ui/SectionHeading.astro';
import QuoteForm from '../forms/QuoteForm.astro';
import { empresa } from '../../data/empresa';
import { waLink } from '../../utils/wa';
---

<section class="bg-navy py-16 md:py-24 rounded-lg shadow-md">
  <Container class="grid gap-10 lg:grid-cols-[1fr_1.1fr]">
    <div>
      <SectionHeading
        tone="light"
        eyebrow="Cotización"
        title="Cotiza tu servicio en 1 minuto"
        subtitle="Completa el formulario o escríbenos directo por WhatsApp."
      />

      <div class="mt-6">
        <Button href={waLink('cta-final-home')} variant="wa" size="lg">
          WhatsApp {empresa.telefonoFijo}
        </Button>
      </div>

      <dl class="mt-8 space-y-2 text-sm text-mist/90">
        <div class="flex gap-2"><dt class="font-bold text-white">Horario:</dt><dd>{empresa.horario}</dd></div>
        <div class="flex gap-2"><dt class="font-bold text-white">Respuesta promedio:</dt><dd>30 min</dd></div>
      </dl>
    </div>

    <QuoteForm />
  </Container>
</section>