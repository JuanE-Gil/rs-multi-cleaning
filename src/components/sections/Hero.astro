---
import Container from "../ui/Container.astro";
import Badge from "../ui/Badge.astro";
import Button from "../ui/Button.astro";
import { casosAntesDespues } from "../../data/casos";
import { waLink } from "../../utils/wa";

const caso = casosAntesDespues[0];
---

<section class="bg-mist">
  <Container class="grid items-center gap-10 py-14 md:grid-cols-2 md:py-20">
    <div>
      <Badge tone="green" class="mb-4">
        <span aria-hidden="true">●</span> Insumos biodegradables
      </Badge>
      
      <h1 class="font-display font-bold text-[#0f2942] max-w-xl text-3xl sm:text-4xl lg:text-[2.6rem] leading-[1.15] tracking-tight">
        Lavado y desinfección de muebles y colchones{" "}
        <span class="text-[#007a87]">a domicilio en Lima</span>
      </h1>

      <p class="mt-5 max-w-[46ch] text-lg leading-relaxed text-slate-ink">
        Limpieza profunda y desinfección a vapor de tapicería, colchones,
        alfombras, roller, interiores de auto y línea infantil. Insumos
        biodegradables, seguros para niños y mascotas.
      </p>

      <div class="mt-7 flex flex-wrap gap-3">
        <Button href="/contacto" variant="primary" size="lg">
          Solicitar cotización
        </Button>
        <Button href={waLink("hero-home")} variant="wa" size="lg">
          WhatsApp directo
        </Button>
      </div>

      <p class="mt-5 text-sm font-semibold text-slate-ink">
        <span aria-hidden="true">✓</span> Respuesta en 30 min&nbsp; <span aria-hidden="true">✓</span> Kärcher Puzzi&nbsp; <span aria-hidden="true">✓</span> Anti ácaros
      </p>
    </div>

    <div class="grid grid-cols-2 gap-2">
      <figure class="relative overflow-hidden rounded-lg">
        <img
          src={caso.antesImg}
          alt={caso.antesAlt}
          width="800"
          height="600"
          class="h-full w-full object-cover"
          loading="eager"
        />
        <figcaption class="absolute left-2 top-2 rounded-full bg-black/65 px-2.5 py-0.5 text-xs font-bold uppercase tracking-wide text-white">
          Antes
        </figcaption>
      </figure>
      <figure class="relative overflow-hidden rounded-lg">
        <img
          src={caso.despuesImg}
          alt={caso.despuesAlt}
          width="800"
          height="600"
          class="h-full w-full object-cover"
          loading="eager"
        />
        <figcaption class="absolute left-2 top-2 rounded-full bg-teal-900 px-2.5 py-0.5 text-xs font-bold uppercase tracking-wide text-white">
          Después
        </figcaption>
      </figure>
    </div>
  </Container>
</section>
