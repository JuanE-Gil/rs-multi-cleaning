---
import Container from "../ui/Container.astro";
import SectionHeading from "../ui/SectionHeading.astro";
import { pasosProceso } from "../../data/proceso";
---

<section class="py-16 md:py-24 border border-hairline rounded-lg shadow-sm">
  <Container>
    <SectionHeading eyebrow="Proceso" title="Cuatro pasos, sin incertidumbre" />

    <ol class="mt-10 grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
      {pasosProceso.map((paso, i) => (
        <li class="relative rounded-lg border border-hairline bg-white p-5 shadow-sm">
          <span class="flex h-9 w-9 items-center justify-center rounded-full bg-teal-900 font-display text-sm font-bold text-white">
            {paso.numero}
          </span>
          <h3 class="mt-3 font-display text-base font-bold text-navy">
            {paso.titulo}
          </h3>
          <p class="mt-1 text-sm text-slate-ink">{paso.descripcion}</p>

          {i < pasosProceso.length - 1 && (
            <span
              class="absolute -right-2.5 top-1/2 hidden -translate-y-1/2 text-teal lg:block"
              aria-hidden="true"
            >
              →
            </span>
          )}
        </li>
      ))}
    </ol>
  </Container>
</section>
