---
import { casosAntesDespues } from "../../data/casos";
import Container from "../ui/Container.astro";
import SectionHeading from "../ui/SectionHeading.astro";

const caso = casosAntesDespues[0];
---

<section class="bg-mist py-16 md:py-24">
  <Container>
    <SectionHeading
      eyebrow="Antes / Después"
      title="La prueba que ningún catálogo puede darte"
      subtitle={caso.descripcion}
    />

    <div
      id="ba-container"
      class="relative mx-auto mt-10 aspect-4/3 max-w-2xl overflow-hidden rounded-2xl shadow-xl select-none group focus-within:[outline:3px_solid_var(--color-teal-ink)] focus-within:[outline-offset:4px]"
    >
      <!-- Capa DESPUÉS (Fondo) -->
      <img
        src={caso.despuesImg || "/placeholder-despues.jpg"}
        alt={caso.despuesAlt}
        width="800"
        height="600"
        class="absolute inset-0 h-full w-full object-cover"
      />
      <span class="absolute top-4 right-4 z-10 rounded-full bg-black/60 px-3 py-1 text-xs font-semibold text-white backdrop-blur-md">
        DESPUÉS
      </span>

      <!-- Capa ANTES (Recortada con clip-path) -->
      <div
        id="ba-antes"
        class="absolute inset-0 h-full w-full"
        style="clip-path: inset(0 50% 0 0);"
      >
        <img
          src={caso.antesImg || "/placeholder-antes.jpg"}
          alt={caso.antesAlt}
          width="800"
          height="600"
          class="h-full w-full object-cover aspect-4/3"
        />
        <span class="absolute top-4 left-4 z-10 rounded-full bg-black/60 px-3 py-1 text-xs font-semibold text-white backdrop-blur-md">
          ANTES
        </span>
      </div>

      <!-- Divider y Handle UI -->
      <div
        id="ba-handle"
        class="absolute top-0 bottom-0 z-20 w-0.5 bg-white shadow-[0_0_10px_rgba(0,0,0,0.5)]"
        style="left: 50%;"
      >
        <div class="absolute top-1/2 -translate-x-1/2 -translate-y-1/2 flex h-10 w-10 items-center justify-center rounded-full bg-white text-navy shadow-lg transition-shadow group-hover:shadow-xl">
          <svg
            aria-hidden="true"
            xmlns="http://www.w3.org/2000/svg"
            class="h-5 w-5"
            fill="none"
            viewBox="0 0 24 24"
            stroke="currentColor"
            stroke-width="2.5"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              d="M8 9l-3 3m0 0l3 3m-3-3h12m-3-6l3 3m0 0l-3 3"
            />
          </svg>
        </div>
      </div>

      <!-- Control Range Invisible e Interactivo -->
      <input
        id="ba-range"
        type="range"
        min="0"
        max="100"
        value="50"
        aria-label="Deslizar para comparar antes y después"
        aria-valuetext="50% antes"
        class="absolute inset-0 z-30 h-full w-full cursor-ew-resize opacity-0"
      />
    </div>
  </Container>
</section>

<script>
  const range = document.getElementById("ba-range") as HTMLInputElement;
  const antes = document.getElementById("ba-antes");
  const handle = document.getElementById("ba-handle");

  if (range && antes && handle) {
    range.addEventListener("input", (e) => {
      const val = (e.target as HTMLInputElement).value;
      antes.style.clipPath = `inset(0 ${100 - Number(val)}% 0 0)`;
      handle.style.left = `${val}%`;
      range.setAttribute("aria-valuetext", `${val}% antes`);
    });
  }
</script>
