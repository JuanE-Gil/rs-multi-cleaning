---
import Container from '../ui/Container.astro';
import SectionHeading from '../ui/SectionHeading.astro';
import { testimonios } from '../../data/testimonios';
---

<section class="py-16 md:py-24 border border-hairline rounded-lg shadow-md">
  <Container>
    <SectionHeading eyebrow="Testimonios" title="Lo que dicen quienes ya contrataron" />

    <div class="mt-10 flex snap-x snap-mandatory gap-5 overflow-x-auto pb-2 sm:grid sm:grid-cols-3 sm:overflow-visible">
      {testimonios.map((t) => (
        <div class="min-w-[85%] shrink-0 snap-start rounded-lg border border-hairline bg-white p-5 shadow-sm sm:min-w-0">
          <p class="text-sm leading-relaxed text-ink">"{t.texto}"</p>
          <p class="mt-4 text-sm font-bold text-navy">{t.nombre}</p>
          <p class="text-xs text-slate-ink">{t.distrito} · {t.servicio}</p>
        </div>
      ))}
    </div>
  </Container>
</section>