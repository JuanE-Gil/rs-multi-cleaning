---
import Container from "../ui/Container.astro";
import SectionHeading from "../ui/SectionHeading.astro";

import { serviciosDestacados } from "../../data/servicios";
import Card from "../ui/Card.astro";
import ImagePlaceholder from "../ui/ImagePlaceholder.astro";
import Button from "../ui/Button.astro";

const lista = serviciosDestacados.filter((s) => s.destacado);
if (lista.length !== 3) throw new Error("La home esperaba exactamente 3 servicios destacados");
---

<section
  id="servicios"
  class="scroll-mt-24 py-16 md:py-24"
>
  <Container>
    <SectionHeading
      eyebrow="Servicios"
      title="Tres servicios para empezar"
      subtitle="Cada tratamiento se adapta al material: agua, seco, vapor."
    />

    <div class="mt-10 grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
      {lista.map((s) => (
        <Card class="flex flex-col gap-3">
          <ImagePlaceholder label={s.imagenAlt} ratio="16/9" />
          <h3 class="font-display text-lg font-bold text-navy">{s.nombre}</h3>
          <p class="text-sm text-slate-ink">{s.metodo}</p>
          <div class="mt-auto flex items-center justify-between pt-2">
            <!-- <span class="text-sm font-bold text-teal-ink">{s.precioDesde}</span> -->
            <a
              href={`/services/${s.slug}`}
              aria-label={`Ver detalle de ${s.nombre}`}
              class="inline-flex min-h-6 items-center text-sm font-bold text-teal-ink transition-colors hover:text-navy"
            >
              Ver detalle →
            </a>
          </div>
        </Card>
      ))}
    </div>

    <div class="mt-10">
      <Button
        href="/services"
        variant="secondary"
        size="lg">Ver todos los servicios</Button>
    </div>

  </Container>
</section>
