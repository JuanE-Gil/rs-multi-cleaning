---
import Container from "../ui/Container.astro";

const items = [
  { l1: "RUC activo", l2: "SUNAT" },
  { l1: "Insumos", l2: "biodegradables" },
  { l1: "Maquinaria", l2: "Kärcher" },
  { l1: "Garantía", l2: "de servicio" },
];
---

<section class="bg-navy rounded-lg shadow-sm">
  <Container class="grid grid-cols-2 gap-6 py-6 sm:grid-cols-4">
    {items.map((item) => (
      <div class="flex items-center gap-3">
        <span
          class="flex h-8 w-8 shrink-0 items-center justify-center rounded-full bg-teal text-white"
          aria-hidden="true"
        >
          <svg
            width="16"
            height="16"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2.5"
            stroke-linecap="round"
          >
            <path d="M20 6 9 17l-5-5" />
          </svg>
        </span>
        <span class="text-sm font-semibold leading-tight text-mist">
          {item.l1}
          <br />
          {item.l2}
        </span>
      </div>
    ))}
  </Container>
</section>
