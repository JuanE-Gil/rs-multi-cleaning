---
interface Props {
  label: string;
  ratio?: string; // '4/3' · '16/9' · '1/1'
  class?: string;
}

const { label, ratio = '4/3', class: className } = Astro.props;
---

<div
  class:list={[
    'flex items-center justify-center rounded-md border-2 border-dashed border-navy-100 bg-navy-50 text-center',
    className,
  ]}
  style={`aspect-ratio: ${ratio}`}
>
  <span class="px-3 text-xs font-semibold text-slate-ink">{label}</span>
</div>