---
interface Props {
  tone?: "mist" | "green";
  class?: string;
}

const { tone = "mist", class: className } = Astro.props;

const tones = {
  mist: "bg-mist text-teal-ink",
  green: "bg-green-100 text-green-ink",
};
---

<span
  class:list={[
    "inline-flex items-center gap-1.5 rounded-full px-3 py-1 text-xs font-bold font-body",
    tones[tone],
    className,
  ]}
>
  <slot />
</span>
