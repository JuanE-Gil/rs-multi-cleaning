---
interface Props {
  title: string;
  description?: string;
  image?: string;
}

const { title, description, image = "/og-default.jpg" } = Astro.props as Props;
const canonicalURL = Astro.site
  ? new URL(Astro.site + Astro.url.pathname).toString()
  : null;
---

<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
<link rel="canonical" href={canonicalURL} />

<title>{title}</title>
<meta name="description" content={description} />

<meta property="og:type" content="website" />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta
  property="og:image"
  content={
    Astro.site ? new URL(Astro.site + Astro.url.pathname).toString() : null
  }
/>
<meta property="og:url" content={canonicalURL} />
<meta property="og:locale" content="es_PE" />
<meta name="twitter:card" content="summary_large_image" />

<meta name="theme-color" content="#0F2C59" />
