---
import Container from "../../components/ui/Container.astro";
import SectionHeading from "../../components/ui/SectionHeading.astro";
import Button from "../../components/ui/Button.astro";
import Card from "../../components/ui/Card.astro";
import ImagePlaceholder from "../../components/ui/ImagePlaceholder.astro";
import PageLayout from "../../layouts/PageLayout.astro";
import { serviciosDestacados } from "../../data/servicios";
import type { ServicioResumen } from "../../data/servicios";
import { casosAntesDespues } from "../../data/casos";
import { waLink } from "../../utils/wa";

export function getStaticPaths() {
  return serviciosDestacados.map((servicio) => ({
    params: { slug: servicio.slug },
    props: { servicio },
  }));
}

const { servicio } = Astro.props as { servicio: ServicioResumen };

const caso = casosAntesDespues.find((c) => c.id === servicio.casoId);
const relacionados = serviciosDestacados
  .filter((s) => s.slug !== servicio.slug)
  .slice(0, 3);
const wa = waLink(`servicio-${servicio.slug}`, servicio.nombre);

const faqJsonLd = JSON.stringify({
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: servicio.faq.map((f) => ({
    "@type": "Question",
    name: f.pregunta,
    acceptedAnswer: { "@type": "Answer", text: f.respuesta },
  })),
});
---

<PageLayout
  title={`${servicio.nombre} en Lima — ${servicio.metodo} | R&S Multi Cleaning`}
  description={servicio.bajada}
  currentPage="servicios"
>
  <section class="bg-mist">
    <Container class="py-12 md:py-16">
      <nav aria-label="Ruta de navegación" class="text-sm text-slate-ink">
        <ol class="flex flex-wrap items-center gap-2">
          <li><a href="/" class="hover:text-navy">Inicio</a></li>
          <li aria-hidden="true">/</li>
          <li><a href="/servicios" class="hover:text-navy">Servicios</a></li>
          <li aria-hidden="true">/</li>
          <li aria-current="page" class="font-semibold text-navy">{servicio.nombre}</li>
        </ol>
      </nav>

      <h1 class="mt-6 max-w-3xl font-display text-3xl font-extrabold leading-[1.15] tracking-tight text-navy sm:text-4xl lg:text-[2.6rem]">
        {servicio.nombre} en Lima — {servicio.metodo}
      </h1>

      <p class="mt-5 max-w-[62ch] text-lg leading-relaxed text-slate-ink">
        {servicio.bajada}
      </p>

      <div class="mt-7 flex flex-wrap gap-3">
        <Button href="/contacto" variant="primary" size="lg">
          Solicitar cotización
        </Button>
        <Button href={wa} variant="wa" size="lg">
          Cotizar por WhatsApp
        </Button>
      </div>
    </Container>
  </section>

  <Container class="py-16 md:py-24">
    <SectionHeading
      eyebrow="Antes y después"
      title={`Resultado en ${servicio.nombre.toLowerCase()}`}
    />

    {caso ? (
      <div class="mt-8 grid gap-4 sm:grid-cols-2">
        <figure>
          <img
            src={caso.antesImg}
            alt={caso.antesAlt}
            width="800"
            height="600"
            loading="lazy"
            class="w-full rounded-lg object-cover"
          />
          <figcaption class="mt-2 text-sm font-semibold text-slate-ink">
            Antes — {caso.descripcion}
          </figcaption>
        </figure>
        <figure>
          <img
            src={caso.despuesImg}
            alt={caso.despuesAlt}
            width="800"
            height="600"
            loading="lazy"
            class="w-full rounded-lg object-cover"
          />
          <figcaption class="mt-2 text-sm font-semibold text-slate-ink">
            Después del lavado a vapor
          </figcaption>
        </figure>
      </div>
    ) : (
      <div class="mt-8">
        <ImagePlaceholder
          label={`Fotos reales de ${servicio.nombre.toLowerCase()} — pendiente de la fase 0`}
          ratio="16/9"
        />
        <p class="mt-3 text-sm text-slate-ink">
          No publicamos fotos de otro servicio como si fueran de este. Estamos
          cargando casos reales de {servicio.nombre.toLowerCase()}.
        </p>
      </div>
    )}
  </Container>

  <section class="border border-hairline py-16 md:py-24">
    <Container>
      <SectionHeading
        eyebrow="Señales"
        title="¿Cuándo necesitas este servicio?"
        subtitle="Si te reconoces en dos o más, conviene una revisión."
      />
      <ul class="mt-8 grid gap-4 sm:grid-cols-3">
        {servicio.senales.map((senal) => (
          <li class="rounded-lg border border-hairline bg-white p-5 text-sm font-semibold text-navy shadow-sm">
            {senal}
          </li>
        ))}
      </ul>
    </Container>
  </section>

  <Container class="py-16 md:py-24">
    <SectionHeading
      eyebrow="Proceso"
      title={`El proceso para ${servicio.nombre.toLowerCase()}`}
      subtitle={`Método: ${servicio.metodo}.`}
    />
    <ol class="mt-8 grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
      {servicio.proceso.map((paso, i) => (
        <li class="rounded-lg border border-hairline bg-white p-5 shadow-sm">
          <span class="flex h-9 w-9 items-center justify-center rounded-full bg-teal font-display text-sm font-bold text-white">
            {i + 1}
          </span>
          <p class="mt-3 text-sm font-semibold text-navy">{paso}</p>
        </li>
      ))}
    </ol>
  </Container>

  <section class="bg-mist py-16 md:py-24">
    <Container class="grid gap-8 md:grid-cols-2">
      <div>
        <h2 class="font-display text-xl font-extrabold text-navy">Qué incluye</h2>
        <ul class="mt-4 space-y-2">
          {servicio.incluye.map((item) => (
            <li class="flex gap-2 text-sm text-ink">
              <span class="text-teal-ink" aria-hidden="true">✓</span>
              {item}
            </li>
          ))}
        </ul>
      </div>
      <div>
        <h2 class="font-display text-xl font-extrabold text-navy">Qué no incluye</h2>
        <ul class="mt-4 space-y-2">
          {servicio.noIncluye.map((item) => (
            <li class="flex gap-2 text-sm text-ink">
              <span class="text-slate-ink" aria-hidden="true">—</span>
              {item}
            </li>
          ))}
        </ul>
      </div>
    </Container>
  </section>

  <Container class="py-16 md:py-24">
    <div class="rounded-lg bg-navy p-6 md:p-10">
      <h2 class="font-display text-2xl font-extrabold text-white">Precio</h2>
      <p class="mt-3 max-w-[62ch] text-base leading-relaxed text-mist/90">
        No publicamos una tarifa fija porque el precio varía según {servicio.precioVaria}
      </p>
      <p class="mt-3 max-w-[62ch] text-base leading-relaxed text-mist/90">
        Envíanos una foto por WhatsApp y te damos un rango. El precio final se
        confirma en el diagnóstico, antes de empezar.
      </p>
      <div class="mt-6">
        <Button href={wa} variant="wa" size="lg">Pedir mi rango de precio</Button>
      </div>
    </div>
  </Container>

  <section class="border-t border-hairline py-16 md:py-24">
    <Container class="max-w-3xl">
      <SectionHeading eyebrow="Preguntas" title="Dudas frecuentes" />
      <div class="mt-8 space-y-3">
        {servicio.faq.map((item) => (
          <details class="rounded-lg border border-hairline bg-white p-5">
            <summary class="cursor-pointer font-display text-base font-bold text-navy">
              {item.pregunta}
            </summary>
            <p class="mt-3 text-sm leading-relaxed text-ink">{item.respuesta}</p>
          </details>
        ))}
      </div>
    </Container>
  </section>

  <Container class="py-16 md:py-24">
    <SectionHeading eyebrow="También te puede servir" title="Otros servicios" />
    <div class="mt-8 grid gap-5 sm:grid-cols-3">
      {relacionados.map((s) => (
        <Card>
          <h3 class="font-display text-lg font-bold text-navy">{s.nombre}</h3>
          <p class="mt-1 text-sm text-slate-ink">{s.metodo}</p>
          <a
            href={`/servicios/${s.slug}`}
            class="mt-4 inline-block text-sm font-bold text-teal-ink hover:text-navy"
          >
            Ver detalle →
          </a>
        </Card>
      ))}
    </div>
  </Container>

  <section class="bg-navy py-16 md:py-24">
    <Container class="text-center">
      <h2 class="font-display text-2xl font-extrabold text-white sm:text-3xl">
        Agenda tu limpieza de {servicio.nombre.toLowerCase()} en Lima
      </h2>
      <p class="mx-auto mt-3 max-w-[52ch] text-base text-mist/90">
        Coordinamos el día, la hora y el acceso. Tú solo eliges el momento.
      </p>
      <div class="mt-7 flex flex-wrap justify-center gap-3">
        <Button href={wa} variant="wa" size="lg">Cotizar por WhatsApp</Button>
        <Button href="/contacto" variant="ghost" size="lg">Dejar mis datos</Button>
      </div>
    </Container>
  </section>

  <script type="application/ld+json" is:inline set:html={faqJsonLd} />
</PageLayout>
