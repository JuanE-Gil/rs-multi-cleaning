---
import MobileActionBar from "../components/widgets/MobileActionBar.astro";
import WhatsAppFab from "../components/widgets/WhatsAppFab.astro";
import BaseLayout from "./BaseLayout.astro";
import Footer from "../components/layout/Footer.astro";
import Header from "../components/layout/Header.astro";
import SkipLink from "../components/layout/SkipLink.astro";

interface Props {
  title: string;
  description?: string;
  image?: string; // ruta relativa
  currentPage: "inicio" | "servicios" | "nosotros" | "contacto";
}

const { title, description, image, currentPage } = Astro.props as Props;
---

<BaseLayout title={title} description={description} image={image}>
  <SkipLink />
  <Header currentPage={currentPage} />
  <main id="main">
    <slot />
  </main>
  <Footer />
  <WhatsAppFab origen="fab-global" />
  <MobileActionBar />
</BaseLayout>
